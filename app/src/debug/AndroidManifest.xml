<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug builds talk to the backend on this PC (10.0.2.2 from the emulator). Apps targeting
         Android 17 need this permission to reach local-network addresses; without it connections
         silently time out. Release builds use a public HTTPS backend and don't request it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
